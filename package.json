{
  "name": "sonraoku",
  "version": "0.3.0",
  "main": "index.ts",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinefi/sonraoku.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/kinefi/sonraoku/issues",
    "email": "toplumbilisim+sonraoku@gmail.com"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "expo start",
    "fix": "expo install --fix && pnpm dedupe",
    "android": "expo run:android",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "doctor": "npx expo-doctor",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "build:android": "eas build --platform android --non-interactive",
    "build:android:ci": "eas build --platform android --profile production --local",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:ci": "eas build --platform android --profile preview --local",
    "build:all": "eas build --platform all --non-interactive",
    "submit:android": "eas submit --platform android",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@mozilla/readability": "^0.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.62.3",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.23",
    "expo-background-fetch": "~57.0.18",
    "expo-clipboard": "^57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "^57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "^57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.20",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-task-manager": "~57.0.18",
    "fast-xml-parser": "^5.11.1",
    "nanoid": "^3.3.19",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "~19.2.18",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.12",
    "commit-and-tag-version": "^12.7.3",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo-dev-client": "~57.0.19",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
